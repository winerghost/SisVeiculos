# Copie para .env (fora do git) e preencha. Nunca commite o .env.
# Gere segredos com: openssl rand -hex 32   (hex evita caracteres que quebram a URL do Postgres)

# Chave global da API (cabeçalho "apikey"). Só administração; no n8n use o token da instância.
EVOLUTION_GLOBAL_API_KEY=

# Senha do Postgres da Evolution (use só hex/letras/números).
POSTGRES_USER=evogo
POSTGRES_PASSWORD=

# Recomendado: fixe a imagem pelo digest em vez de "latest".
# Descubra com: docker pull evoapicloud/evolution-go:latest && docker inspect --format '{{index .RepoDigests 0}}' evoapicloud/evolution-go:latest
EVOLUTION_GO_IMAGE=evoapicloud/evolution-go:latest
EVOLUTION_POSTGRES_IMAGE=postgres:16-alpine

# Porta só em 127.0.0.1 (o 8080 já é do SisVeiculos). Confira se está livre: ss -ltnp | grep 8081
EVOLUTION_PORTA_LOCAL=8081

EVOLUTION_CLIENT_NAME=sisveiculos
EVOLUTION_OS_NAME=SisVeiculos
EVOLUTION_WADEBUG=INFO

# Webhook de retorno para o n8n pela rede interna (opcional). Ex.:
# EVOLUTION_WEBHOOK_URL=http://n8n:5678/webhook/<caminho-secreto>
EVOLUTION_WEBHOOK_URL=

# Ativação da licença sem abrir o /manager (opcional).
EVOLUTION_OPERATOR_EMAIL=

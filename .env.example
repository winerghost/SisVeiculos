# Copie para .env e preencha direto no arquivo. Nunca cole chaves em chat nem commite o .env.
# O docker-compose repassa ao backend SOMENTE a lista explícita abaixo (sem env_file).

# --- Porta do HOST onde o frontend escuta (somente 127.0.0.1) ---
# É o endereço do proxy reverso do CloudPanel: http://127.0.0.1:<FRONTEND_PORT> (aponte para o
# FRONTEND, nunca para o backend, que não publica porta). Em VPS com vários sistemas escolha uma
# porta LIVRE: confira com `ss -ltn | grep :<porta>` antes. Padrão se vazio: 8080.
# Mudar só isto exige `docker compose up -d` (sem --build) e atualizar o proxy do CloudPanel.
FRONTEND_PORT=8080

# --- Supabase: PÚBLICAS (entram no build do frontend; mudar exige --build) ---
# O host de NEXT_PUBLIC_SUPABASE_URL também define o host permitido na CSP do nginx.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site: URL pública https (OBRIGATÓRIA, parâmetro de BUILD) ---
# Sem barra final, ex.: https://SEU-DOMINIO. Usada nas URLs absolutas de og:image/og:url
# (pré-visualização de links). Mudar exige `docker compose up -d --build`; defina ANTES do
# primeiro build. O build falha se vazia, http:// ou localhost.
NEXT_PUBLIC_SITE_URL=https://SEU-DOMINIO

# --- Supabase: backend (SECRETAS, nunca no frontend) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Validação do JWT no Flask (assinatura, exp, aud, iss)
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=

# --- Backend Flask ---
CORS_ORIGINS=
# Opcional. Padrão do código se vazio.
LOG_LEVEL=
# Permite o solicitante autorizar a própria requisição. Padrão: false. Mantenha false em produção
# (separação de funções); só habilite com aprovação explícita da gestão.
PERMITIR_AUTOAUTORIZACAO=false
# URL https da página de aceite de convite do frontend (o token vai na query `convite`).
# Sem ela, POST /api/admin/usuarios responde 503 convites_nao_configurados.
# Também precisa estar em Redirect URLs do Supabase Auth (ver docs/convites-supabase-auth.md).
URL_ACEITE_CONVITE=https://SEU-DOMINIO/convite

# --- n8n (webhook externo, só notifica; DESLIGADO por padrão) ---
# Só liga se os DOIS estiverem preenchidos. A URL deve ser https com host público (o backend
# recusa http, localhost, IP privado/loopback e credenciais na URL). Trate o caminho do webhook
# como segredo. Token: 32+ caracteres aleatórios; vai só no header Authorization: Bearer.
# O n8n deve validar X-Assinatura (HMAC-SHA256 de "<X-Timestamp>.<corpo>") e a janela de
# X-Timestamp (ex.: ±5 min).
# N8N_HMAC_SECRET (opcional): chave exclusiva da assinatura, distinta do token (mín. 32
# caracteres; gere com: openssl rand -hex 32). Se vazia, a assinatura usa o N8N_WEBHOOK_TOKEN
# (o backend registra um aviso no startup). Configure o MESMO valor no n8n para verificar a
# assinatura. Migração sem downtime: 1) defina o segredo no n8n aceitando as duas assinaturas
# (a antiga, com o token, e a nova); 2) defina N8N_HMAC_SECRET aqui e reinicie o backend;
# 3) no n8n, remova a verificação com o token.
# O payload nunca leva dados pessoais (só evento, ids da requisição/veículo, status, unidade).
# Em PRODUÇÃO, com o n8n ligado (URL ou token definidos), N8N_HMAC_SECRET é OBRIGATÓRIO e
# deve ser diferente do token (o backend não sobe sem ele).
# N8N_ALLOWED_HOSTS (opcional): hosts permitidos para o webhook, separados por vírgula (só o
# nome, sem https:// nem caminho). Se definido, o host de N8N_WEBHOOK_URL precisa constar.
# Além disso, a cada entrega o backend resolve o DNS e recusa destinos não públicos (anti-SSRF).
# RECOMENDADO em produção: preencher N8N_ALLOWED_HOSTS com o host exato do n8n (não é obrigatório;
# sem ele vale qualquer host público, o que amplia a superfície caso a URL seja alterada).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_HMAC_SECRET=
N8N_ALLOWED_HOSTS=

# --- IP do cliente (rate limit e histórico de acessos) ---
# TRUSTED_PROXY_CIDRS (opcional): redes dos proxies cujo CF-Connecting-IP o backend aceita.
# Padrão: 10.213.88.0/24 (sub-rede fixa do docker-compose, onde roda o nginx do frontend) e
# loopback. Só altere se mudar a sub-rede do docker-compose.yml (e o set_real_ip_from do nginx).
# Qualquer outra origem tem o cabeçalho ignorado e vale o IP da conexão. O backend recusa subir
# com rede pública ou larga demais (prefixo menor que /16 em IPv4 ou /48 em IPv6, ex.: 0.0.0.0/0).
TRUSTED_PROXY_CIDRS=

# --- IA opcional (DESLIGADA por padrão) ---
# AI_ENABLED=false vence qualquer configuração feita na tela de Configurações.
# Chaves: SEGREDOS do backend. Nunca no banco, no frontend (sem NEXT_PUBLIC_), em logs ou em
# respostas da API. Deixe vazio o provedor que não for usado. Provedores: OpenAI e Anthropic.
# A IA só redige/resume: nunca decide autorização nem regra de negócio, e nenhum dado pessoal
# (nome, e-mail, placa, trajeto) vai ao provedor. Sem cota/chave/resposta, o app usa o texto padrão.
AI_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Opcional: lista permitida de modelos (separados por vírgula; o 1º é o padrão). Vazio = padrão do
# código (OpenAI: gpt-5.4-mini; Anthropic: claude-haiku-5-5, claude-sonnet-5-5). Confirme o nome
# do modelo OpenAI na documentação do provedor antes de ligar.
AI_MODELOS_OPENAI=
AI_MODELOS_ANTHROPIC=
AI_TIMEOUT_SECONDS=20
AI_MAX_TOKENS=800
# Limites por hora (por usuário / por unidade).
AI_RATE_LIMIT_PER_USER=20
AI_RATE_LIMIT_PER_UNIT=100
# Teto global de tokens por mês (o menor entre este e o da tela vale).
AI_MONTHLY_TOKEN_CAP=200000
# Circuit breaker por provedor: falhas consecutivas que abrem o circuito e duração (s).
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_OPEN_SECONDS=300

# --- E-mail dos relatórios (SMTP; DESLIGADO por padrão) ---
# O envio só funciona com EMAIL_ENABLED=true E o recurso "Relatórios por e-mail" ligado em
# Configurações (admin). Credenciais são SEGREDOS do backend: nunca no banco, no frontend, em logs
# ou em respostas. EMAIL_SECURITY: starttls (porta 587, recomendado) ou ssl (porta 465); "none"
# só em desenvolvimento (o backend recusa none em produção com o e-mail ligado). EMAIL_MAX_PER_HOUR: cota global de envios por hora (1 a 1000).
EMAIL_ENABLED=false
# EMAIL_DOMINIOS_RELATORIO: domínios institucionais (separados por vírgula, comparação exata) que
# podem receber por e-mail relatórios com nomes, trajeto ou auditoria. Vazio = nenhum (esses
# relatórios só podem ser baixados pela tela). Ex.: agu.gov.br. O backend recusa subir com
# curinga (*), formato inválido ou provedor público (gmail.com, hotmail.com, outlook.com etc.).
EMAIL_DOMINIOS_RELATORIO=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SECURITY=starttls
EMAIL_FROM=
EMAIL_FROM_NAME=Controle de Veículos AGU
EMAIL_TIMEOUT_SECONDS=15
EMAIL_MAX_PER_HOUR=30
# Cota por usuário por hora (todos os perfis; 1 a 1000).
EMAIL_MAX_PER_USER_HOUR=5
# Despachante de e-mail das notificações críticas (só roda com EMAIL_ENABLED=true E o recurso
# "E-mail para notificações críticas" ligado em Configurações). Intervalo entre ciclos (5 a 3600 s)
# e teto de e-mails por hora (1 a 1000), contado em memória: vale por processo (1 worker).
EMAIL_NOTIF_INTERVALO_SEGUNDOS=30
EMAIL_NOTIF_MAX_POR_HORA=20

# =====================================================================================
# SOMENTE PIPELINE (CI/CD): cadastre como SECRETS DO GITHUB (Settings > Secrets).
# NÃO coloque no .env da VPS: o servidor não precisa e não deve ter essas credenciais.
# =====================================================================================
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# SEED_ADMIN_EMAIL=
# GITLEAKS_LICENSE=   (necessário só se o repositório pertencer a uma organização GitHub)

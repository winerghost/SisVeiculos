# Copie para .env e preencha direto no arquivo. Nunca cole chaves em chat nem commite o .env.
# O docker-compose repassa ao backend SOMENTE a lista explícita abaixo (sem env_file).

# --- Supabase: PÚBLICAS (entram no build do frontend; mudar exige --build) ---
# O host de NEXT_PUBLIC_SUPABASE_URL também define o host permitido na CSP do nginx.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: backend (SECRETAS, nunca no frontend) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Validação do JWT no Flask (assinatura, exp, aud, iss)
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=

# --- Backend Flask ---
CORS_ORIGINS=
# Opcional. Padrão do código se vazio.
LOG_LEVEL=
# Permite o solicitante autorizar a própria requisição. Padrão: false. Mantenha false em produção
# (separação de funções); só habilite com aprovação explícita da gestão.
PERMITIR_AUTOAUTORIZACAO=false
# URL https da página de aceite de convite do frontend (o token vai na query `convite`).
# Sem ela, POST /api/admin/usuarios responde 503 convites_nao_configurados.
# Também precisa estar em Redirect URLs do Supabase Auth (ver docs/convites-supabase-auth.md).
URL_ACEITE_CONVITE=https://SEU-DOMINIO/convite

# --- n8n (webhook externo, só notifica; DESLIGADO por padrão) ---
# Só liga se os DOIS estiverem preenchidos. A URL deve ser https com host público (o backend
# recusa http, localhost, IP privado/loopback e credenciais na URL). Trate o caminho do webhook
# como segredo. Token: 32+ caracteres aleatórios. O n8n deve validar X-Assinatura
# (HMAC-SHA256 de "<X-Timestamp>.<corpo>" com o token) e a janela de X-Timestamp (ex.: ±5 min).
# O payload nunca leva dados pessoais (só evento, ids da requisição/veículo, status, unidade).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# =====================================================================================
# SOMENTE PIPELINE (CI/CD): cadastre como SECRETS DO GITHUB (Settings > Secrets).
# NÃO coloque no .env da VPS: o servidor não precisa e não deve ter essas credenciais.
# =====================================================================================
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# SEED_ADMIN_EMAIL=
# GITLEAKS_LICENSE=   (necessário só se o repositório pertencer a uma organização GitHub)
